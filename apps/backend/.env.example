# Public address of the server (used in pairing links / QR codes)
PUBLIC_URL=https://tv.nemnogovova.com
DOMAIN=tv.nemnogovova.com
PORT=3000

# Owner (main admin) Google account (optional)
OWNER_EMAIL=nemnogovova@gmail.com
# Owner login for login/password sign-in (optional). Without Google and without this,
# the first account registered on the server becomes the owner.
OWNER_USERNAME=

# Google OAuth 2.0 Web Client ID (optional: leave empty to use login/password only)
GOOGLE_CLIENT_ID=

# Lets scripts/publish-release.mjs upload new app builds (generated by server-setup.sh)
RELEASE_TOKEN=

# Secret used to sign session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional legacy static token for the TV client (pairing by QR is preferred)
DEVICE_TOKEN=

# Optional TURN relay (coturn) for WebRTC casting across networks.
# Leave TURN_SECRET empty to use public STUN only.
TURN_SECRET=
TURN_HOST=tv.nemnogovova.com

DATA_DIR=/data
STATIC_DIR=../remote-client/dist
