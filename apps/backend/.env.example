# Server
PORT=3000

# Owner (main admin) Google account
OWNER_EMAIL=nemnogovova@gmail.com

# Secret token used by the TV client to authenticate as the device
DEVICE_TOKEN=change-me-to-a-long-random-string

# Google OAuth 2.0 Client ID (used to verify Google ID tokens)
GOOGLE_CLIENT_ID=

# Directory where the user/guest whitelist JSON is stored
DATA_DIR=/data

# Static files directory (compiled remote-client)
STATIC_DIR=../remote-client/dist
